<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:meta/>
 <office:automatic-styles>
  <style:page-layout style:name="PL"><style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm"/></style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Diapositiva1" draw:master-page-name="Default">
    <draw:frame svg:x="2cm" svg:y="1cm" svg:width="20cm" svg:height="2cm"><draw:text-box><text:p>Lezione uno</text:p></draw:text-box></draw:frame>
    <draw:frame svg:x="2cm" svg:y="4cm" svg:width="20cm" svg:height="6cm"><draw:text-box><text:p>Introduzione alla città.</text:p></draw:text-box></draw:frame>
   </draw:page>
   <draw:page draw:name="Diapositiva2" draw:master-page-name="Default">
    <draw:frame svg:x="2cm" svg:y="1cm" svg:width="20cm" svg:height="2cm"><draw:text-box><text:p>Cucina</text:p></draw:text-box></draw:frame>
    <draw:frame svg:x="2cm" svg:y="4cm" svg:width="20cm" svg:height="6cm"><draw:text-box><text:p>Cuocere l'aragosta in acqua salata.</text:p></draw:text-box></draw:frame>
   </draw:page>
   <draw:page draw:name="Diapositiva3" draw:master-page-name="Default">
    <draw:frame svg:x="2cm" svg:y="1cm" svg:width="20cm" svg:height="2cm"><draw:text-box><text:p>Fine</text:p></draw:text-box></draw:frame>
    <draw:frame svg:x="2cm" svg:y="4cm" svg:width="20cm" svg:height="6cm"><draw:text-box><text:p>Domande?</text:p></draw:text-box></draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
